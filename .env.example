# AI provider: inception (recommended) or openrouter.
# If INCEPTION_API_KEY is present and AI_PROVIDER is unset, Inception is selected automatically.
AI_PROVIDER=inception

# Inception Labs API: https://api.inceptionlabs.ai/v1
INCEPTION_API_KEY=
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_MODEL=mercury-3

# Optional OpenRouter configuration. Set AI_PROVIDER=openrouter to use it.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Legacy OXION_* variables remain supported for custom OpenAI-compatible endpoints.
# Telegram BotFather token and your numeric Telegram user ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Optional GitHub personal access token for private repositories and higher API limits.
# Use least-privilege access. Leave blank for public GitHub browsing.
GITHUB_TOKEN=

# Files the agent is allowed to access. Defaults to ./workspace
AGENT_WORKSPACE=./workspace
AGENT_MAX_STEPS=12

# Optional: allow localhost/private-IP browser targets for a trusted local development workflow only.
# Leave false for normal use. This changes browser network restrictions.
BROWSER_ALLOW_LOCALHOST=false

# Browser runtime adapts to installed Chromium and can auto-install the managed binary if missing.
# Prefer preinstalling during deployment: npm run browser:install
BROWSER_AUTO_INSTALL=true
# Set true to prefer a detected system browser; optionally pin an absolute executable path.
BROWSER_PREFER_SYSTEM=false
BROWSER_EXECUTABLE_PATH=
# Optional remote fallback/explicit external browser endpoint; keep it private.
BROWSER_CDP_URL=
