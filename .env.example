# Create an API key in your Oxion AI dashboard. Never commit the real key.
OXION_API_KEY=
OXION_BASE_URL=https://www.oxionai.com/v1
OXION_MODEL=deepseek-v4-flash-0731

# Telegram BotFather token and your numeric Telegram user ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Optional GitHub personal access token for private repositories and higher API limits.
# Use least-privilege access. Leave blank for public GitHub browsing.
GITHUB_TOKEN=

# Files the agent is allowed to access. Defaults to ./workspace
AGENT_WORKSPACE=./workspace
AGENT_MAX_STEPS=12

# Optional: allow localhost/private-IP browser targets for a trusted local development workflow only.
# Leave false for normal use. This changes browser network restrictions.
BROWSER_ALLOW_LOCALHOST=false
